      "blocks": [
        {
          "type": "heading",
          "level": 2,
          "text": "Established lore",
          "id": "plaid-men:1"
        },
        {
          "type": "p",
          "spans": [
            {
              "text": "The "
            },
            {
              "text": "Plaid Men",
              "b": true
            },
            {
              "text": " are the Blaewen Ridings' "
            },
            {
              "text": "paid professional infantry",
              "b": true
            },
            {
              "text": ". They remain fundamentally the same kind of soldiers as Albion's ordinary Painted Warriors, but are better provided for under Alfran's organised military system."
            }
          ],
          "id": "plaid-men:2"
        },
        {
          "type": "p",
          "spans": [
            {
              "text": "Their distinctive appearance includes "
            },
            {
              "text": "tartan trousers worn beneath short kilts",
              "b": true
            },
            {
              "text": ", "
            },
            {
              "text": "bronze helmets",
              "b": true
            },
            {
              "text": ", "
            },
            {
              "text": "somewhat more armour",
              "b": true
            },
            {
              "text": ", "
            },
            {
              "text": "moustaches",
              "b": true
            },
            {
              "text": ", and ordinary Albion "
            },
            {
              "text": "round shields",
              "b": true
            },
            {
              "text": ". Their weapons remain within the familiar Albion military tradition; they are not medieval plate-armoured infantry."
            }
          ],
          "id": "plaid-men:3"
        },
        {
          "type": "p",
          "spans": [
            {
              "text": "Their name deliberately suggests both "
            },
            {
              "text": "plaid",
              "b": true
            },
            {
              "text": " cloth and "
            },
            {
              "text": "paid",
              "b": true
            },
            {
              "text": " soldiers."
            }
          ],
          "id": "plaid-men:4"
        },
        {
          "type": "heading",
          "level": 2,
          "text": "Unresolved",
          "id": "plaid-men:5"
        },
        {
          "type": "p",
          "spans": [
            {
              "text": "Exact recruitment, whether moustaches are formally required, equipment variations, battlefield stats, command structure and troop costs are undecided."
            }
          ],
          "id": "plaid-men:6"
        },
